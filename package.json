{
  "name": "lap-by-lap",
  "version": "1.0.0",
  "description": "Lap by Lap: the 2025 Formula 1 season, every lap, in MongoDB (Node.js + Express + React)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.js",
    "build": "vite build",
    "dev": "vite",
    "serve": "node server.js",
    "test": "node --test test/api.test.js",
    "data:build": "python3 scripts/build_season.py",
    "photos:fetch": "node scripts/fetch-driver-photos.mjs",
    "cars:fetch": "node scripts/fetch-car-photos.mjs",
    "docker": "docker compose up --build",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "shell": "docker compose exec mongo mongosh motorsport",
    "db:setup": "node scripts/setup-db.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "animejs": "^4.5.0",
    "country-flag-icons": "^1.6.20",
    "lenis": "^1.3.26",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  }
}
