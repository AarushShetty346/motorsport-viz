# Copy this file to .env and fill in the two Google values (see "Sign in with Google" in the README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# The address you open the app at. Google must have PUBLIC_URL/api/auth/google/callback as a redirect URI.
PUBLIC_URL=http://localhost:3000
